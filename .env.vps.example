# Template for the VPS .env  (copy to .env on the VPS, then fill in the real values).
# Never commit the real .env. Start from your home-server .env backup and change ONLY the lines marked CHANGE.

# --- Django ---
SECRET_KEY=keep-the-same-value-as-the-home-server
# CHANGE (was True)
DEBUG=False
# CHANGE
ALLOWED_HOSTS=sepbot-new.tanchonhomserverxxx.online,app11.tanchonhomserverxxx.online
# CHANGE
CSRF_TRUSTED_ORIGINS=https://sepbot-new.tanchonhomserverxxx.online,https://app11.tanchonhomserverxxx.online
# CHANGE during testing; switch to https://app11... at cut-over
BASE_URL=https://sepbot-new.tanchonhomserverxxx.online
PORT=8020

# --- Database (Postgres container in docker-compose.vps.yml) ---
POSTGRES_DB=sepbot_db
POSTGRES_USER=postgres
# CHANGE (new database => new password)
POSTGRES_PASSWORD=choose-a-new-strong-password
# CHANGE (was postgres_server)
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- LINE / AI / contacts: copy the values from the home-server .env unchanged ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_ID_REGISTER=
LINE_LIFF_ID_DAILY_CHECK=
LINE_LIFF_ID_SCREENING=
LINE_LIFF_ID_VITAL_SIGN=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEEPSEEK_API_KEY=
EMERGENCY_PHONE_1669=1669
EMERGENCY_PHONE_191=191
HOSPITAL_CHULA_PHONE=022564000
NURSE_CONTACT_PHONE=0996244555
NURSE_LINE_PERSONAL_LINK=https://line.me/ti/p/~sepsiscare_nurse
